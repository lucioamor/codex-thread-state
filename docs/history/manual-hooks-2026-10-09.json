          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/codex-thread-state/thread_state.py hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python /path/to/codex-thread-state/thread_state.py hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ]
  }
}
