{
  "description": "Thread State lifecycle hooks, packaged for Codex.",
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 3,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/thread_state.py\" hook",
            "async": true,
            "timeout": 30,
            "statusMessage": "Thread State"
          }
        ]
      }
    ]
  }
}
